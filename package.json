{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "PORT=8080 node ./bin/www",
    "migration:create": "npx sequelize-cli migration:create",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:staging": "NODE_ENV=staging npx sequelize-cli db:migrate",
    "migrate:rollback": "npx sequelize-cli db:migrate:undo"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.3",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "dotenv": "^16.4.7",
    "express": "~4.16.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "~1.9.1",
    "mysql2": "^3.11.5",
    "nodemailer": "^6.9.16",
    "sequelize": "^6.37.5",
    "sequelize-cli": "^6.6.2",
    "zod": "^3.24.1"
  }
}
